# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info

# --- Tuya Cloud (server-side only; never exposed to agents or clients) ---
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Data center base URL. Verify the data center of your Smart Life account in the
# Tuya IoT Platform (Cloud > Development > your project > Overview > Data Center).
# Singapore (official Tuya docs, Request Structure page): https://openapi-sg.iotbing.com
TUYA_BASE_URL=https://openapi-sg.iotbing.com
TUYA_REQUEST_TIMEOUT_MS=10000

# --- Authentication: revocable tokens stored in Postgres ---
# Create/list/revoke tokens with:  npm run token -- create <name> --scope read|write
# Clients send:  Authorization: Bearer nsh_<id>.<secret>   (shown once at creation, only its hash is stored)
# DATABASE_URL        direct connection (migrations: npm run db:migrate, and the token CLI)
# DATABASE_URL_POOLED pooled connection used by the running app
DATABASE_URL=
DATABASE_URL_POOLED=
# Seconds a verified token is cached in-process. A revoked token stops working within this time (0 = every request).
TOKEN_CACHE_TTL_SECONDS=5
# Signs two-step confirmation tokens. Random, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIRMATION_SECRET=

# Hostnames (no ports) accepted in the Host/Origin headers of /mcp (DNS-rebinding protection).
# Add your public hostname when deploying, e.g. MCP_ALLOWED_HOSTS=localhost,home.example.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Also the CORS allowlist for browser dashboards calling /api (see docs/api-reference.md).
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
# Requests per minute allowed per token (per server instance).
RATE_LIMIT_PER_MINUTE=120

# --- Control (write) safety ---
# Control operations allowed per token per minute (per server instance).
WRITE_RATE_LIMIT_PER_MINUTE=30
# Provider category codes treated as high impact: the first control call returns a confirmation
# token and does NOT execute; it must be repeated with the token after the user agrees.
# Best-effort defaults: door locks, garage door openers, water valves. Extend for your devices.
HIGH_IMPACT_CATEGORIES=ms,jtmspro,jtmsbh,ckmkzq,sfkzq
# Set to true to require confirmation for EVERY control action.
CONFIRM_ALL_WRITES=false
# "false" disables every control tool (emergency kill switch; takes effect after restart).
CONTROL_ENABLED=true

# --- Network exposure ---
# Reject plain-HTTP requests (except localhost). Defaults to true when NODE_ENV=production.
# REQUIRE_HTTPS=true
# Number of reverse proxies in front of the app (Caddy/nginx/Cloudflare = 1). 0 = trust no X-Forwarded-* header.
# Behind a TLS-terminating proxy this MUST be >= 1, otherwise requests look like plain HTTP.
TRUSTED_PROXY_HOPS=0
# Requests per minute per client IP, counted BEFORE authentication.
IP_RATE_LIMIT_PER_MINUTE=240
# Usage budget per token per minute (batch reads and the capability catalog cost more; see docs/security.md).
COST_BUDGET_PER_MINUTE=300
# Simultaneous in-flight requests per token.
MAX_CONCURRENT_PER_TOKEN=8
